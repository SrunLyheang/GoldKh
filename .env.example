# Neon — pooled connection string only (see architecture.md invariant 9)
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From the Clerk Dashboard's Webhooks section, once the endpoint is
# registered there (used by app/api/webhooks/clerk/route.ts)
CLERK_WEBHOOK_SIGNING_SECRET=

# Price providers (lib/price/providers only — see architecture.md invariant 1)
GOLDAPI_IO_API_KEY=

# Sentry — a DSN is not a secret (safe in the client bundle), so no
# separate server-only var. Leave unset to disable error tracking
# entirely; Sentry.init() with dsn: undefined is a documented no-op.
NEXT_PUBLIC_SENTRY_DSN=
